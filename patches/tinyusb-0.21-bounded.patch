+// Called by the host task, sharing its admission deadline. IRQ exclusion makes
+// ownership of a deferred endpoint atomic with NAK/close processing.
+void usbhost_dwc2_task(uint32_t begin) {
+  static unsigned cursor;
+  dwc2_regs_t *dwc2 = DWC2_REG(0);
+  for (unsigned n = 0; n < CFG_TUH_DWC2_ENDPOINT_MAX; n++) {
+    unsigned id = cursor;
+    if (++cursor == CFG_TUH_DWC2_ENDPOINT_MAX) cursor = 0;
+    hcd_endpoint_t *ep = &_hcd_data.edpt[id];
+    if (!ep->interrupt_pending) continue;
+    if (!usbhost_work_allowed(begin)) break;
+    hcd_int_disable(0);
+    if (ep->hcchar_bm.enable && !ep->closing && ep->interrupt_pending &&
+        (int32_t)(usb_wait_now() - ep->interrupt_at) >= 0) {
+      ep->interrupt_pending = false;
+      if (!edpt_xfer_kickoff(dwc2, id)) ep->interrupt_pending = true;
+    }
+    hcd_int_enable(0);
+  }
+}
