+// At most one submission per endpoint per pass, with no catch-up after a late
+// pass. Rotate the scan so a busy endpoint cannot starve a later keyboard.
+static void interrupt_poll_task(uint32_t begin) {
+  static unsigned cursor;
+  const unsigned count = TOTAL_DEVICES * CFG_TUH_ENDPOINT_MAX * 2;
+  for (unsigned n = 0; n < count; n++) {
+    if ((n & 15u) == 0 && !usbhost_work_allowed(begin)) break;
+    unsigned slot = cursor;
+    if (++cursor == count) cursor = 0;
+    unsigned d = slot / (CFG_TUH_ENDPOINT_MAX * 2);
+    unsigned ep = (slot / 2) % CFG_TUH_ENDPOINT_MAX, dir = slot % 2;
+    usbh_device_t *dev = &_usbh_devices[d];
+    if (!dev->connected || !dev->poll[ep][dir].pending) continue;
+    if (!usbhost_work_allowed(begin)) break;
+    uint32_t now = usb_wait_now();
+    if (dev->poll[ep][dir].issued && (int32_t)(now - dev->poll[ep][dir].next_us) < 0) continue;
+    uint8_t addr = tu_edpt_addr(ep, dir);
+    dev->poll[ep][dir].pending = false;
+    dev->poll[ep][dir].issued = true;
+    dev->poll[ep][dir].next_us = now + dev->poll[ep][dir].interval_us;
+    usbhost_stats_submit(d+1, addr);
+    if (!hcd_edpt_xfer(dev->bus_info.rhport, d+1, addr,
+                       dev->poll[ep][dir].buffer, dev->poll[ep][dir].length))
+      hcd_event_xfer_complete(d+1, addr, 0, XFER_RESULT_FAILED, false);
+    else usbhost_interrupt_submitted_cb(d+1, addr);
   }
 }

