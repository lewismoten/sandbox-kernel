+// Called only with enumeration and EP0 idle. No shared port status can be overwritten.
+// A deferred interrupt submission has the same recovery policy as an
+// immediate refusal. Clear retry history only when the HCD really accepts it.
+static void hub_poll_refused(uint8_t daddr) {
+  hub_interface_t *h = get_hub_itf(daddr);
+  if (h->poll_retries < USBHOST_POLL_RETRIES) {
+    uint32_t delay = usbhost_backoff(++h->poll_retries);
+    h->poll_retry_at = tusb_time_millis_api() + delay;
+    tuh_hub_poll_retry_cb(daddr, h->poll_retries, delay, "refused");
+  } else {
+    h->want_poll = false;
+    tuh_hub_poll_retry_cb(daddr, h->poll_retries, 0, "exhausted: reset");
+    usbh_hub_poll_failed(daddr);
+  }
+}
+void usbhost_interrupt_submitted_cb(uint8_t daddr, uint8_t ep) {
+  if (daddr <= CFG_TUH_DEVICE_MAX) return;
+  hub_interface_t *h = get_hub_itf(daddr);
+  if (ep != h->ep_in) return;
+  if (h->poll_retries) tuh_hub_poll_retry_cb(daddr, h->poll_retries, 0, "recovered");
+  h->poll_retries = 0;
+  h->poll_retry_at = 0;
+}
+
+void hub_task(void) {
+  if (root_retry.retry_port && usbhost_due(tusb_time_millis_api(), root_retry.retry_at)) {
+    root_retry.retry_port = 0;
+    hcd_event_t event = {.rhport=root_retry_rhport, .event_id=HCD_EVENT_DEVICE_ATTACH,
+                        .connection={.hub_addr=0, .hub_port=0}};
+    hcd_event_handler(&event, false);
+    return;
+  }
+  for (uint8_t i=0; i<CFG_TUH_HUB; i++) {
+    hub_interface_t *h = &hub_itfs[i];
+    uint8_t daddr = i+1+CFG_TUH_DEVICE_MAX;
+    if (!h->ep_in || h->processing || h->poll_active) continue;
+    if (h->retry_port) {
+      if (!usbhost_due(tusb_time_millis_api(), h->retry_at)) continue;
+      uint8_t port = h->retry_port; h->retry_port = 0;
+      hcd_event_t event = {.rhport=usbh_get_rhport(daddr), .event_id=HCD_EVENT_DEVICE_ATTACH,
+                          .connection={.hub_addr=daddr, .hub_port=port}};
+      hcd_event_handler(&event, false); // existing enumeration sequence resets and checks connection
+      return;
+    }
+    if (h->pending) {hub_process_pending(daddr, 0, XFER_RESULT_SUCCESS, 1); return;}
+    if (h->want_poll) {
+      if (h->poll_retries && !usbhost_due(tusb_time_millis_api(), h->poll_retry_at)) continue;
+      if (hub_status_poll(daddr)) {
+        h->want_poll = false;
+      } else {
+        hub_poll_refused(daddr);
+        return;
+      }
+    }
+  }
+}
+
+void hub_root_removed(uint8_t rhport) {
+  if (rhport == root_retry_rhport) tu_memclr(&root_retry, sizeof(root_retry));
+}
+
+void hub_enum_result(uint8_t daddr, uint8_t port, bool success) {
+  hub_interface_t *h = daddr ? get_hub_itf(daddr) : &root_retry;
+  if (daddr ? (!h->ep_in || port == 0 || port > 7) : port != 0) return;
+  if (success) {
+    if (h->retries[port]) tuh_hub_retry_cb(daddr, port, h->retries[port], "recovered");
+    h->retries[port] = 0;
+    if (h->retry_port == (daddr ? port : 1)) {
+      h->retry_port = 0;
+      h->retry_at = 0;
+    }
+  } else if (h->retries[port] < USBHOST_PORT_RETRIES) {
+    h->retries[port]++;
+    h->retry_port = daddr ? port : 1;
+    if (!daddr) root_retry_rhport = usbh_get_rhport(0);
+    h->retry_at = tusb_time_millis_api() + 200u*h->retries[port];
+    tuh_hub_retry_cb(daddr, port, h->retries[port], "reset retry");
+  } else {
+    tuh_hub_retry_cb(daddr, port, h->retries[port], "exhausted");
+  }
+  if (daddr) hub_edpt_status_xfer(daddr);
+}
