+// Called only with enumeration and EP0 idle. No shared port status can be overwritten.
+void hub_task(void) {
+  for (uint8_t i=0; i<CFG_TUH_HUB; i++) {
+    hub_interface_t *h = &hub_itfs[i];
+    uint8_t daddr = i+1+CFG_TUH_DEVICE_MAX;
+    if (!h->ep_in || h->processing || h->poll_active) continue;
+    if (h->retry_port) {
+      if (!usbhost_due(tusb_time_millis_api(), h->retry_at)) continue;
+      uint8_t port = h->retry_port; h->retry_port = 0;
+      hcd_event_t event = {.rhport=usbh_get_rhport(daddr), .event_id=HCD_EVENT_DEVICE_ATTACH,
+                          .connection={.hub_addr=daddr, .hub_port=port}};
+      hcd_event_handler(&event, false); // existing enumeration sequence resets and checks connection
+      return;
+    }
+    if (h->pending) {hub_process_pending(daddr, 0, XFER_RESULT_SUCCESS, 1); return;}
+    if (h->want_poll) {h->want_poll = false; if (!hub_status_poll(daddr)) h->want_poll = true;}
+  }
+}
+
+void hub_enum_result(uint8_t daddr, uint8_t port, bool success) {
+  hub_interface_t *h = get_hub_itf(daddr);
+  if (!h->ep_in || port == 0 || port > 7) return;
+  if (success) {
+    if (h->retries[port]) tuh_hub_retry_cb(daddr, port, h->retries[port], "recovered");
+    h->retries[port] = 0;
+  } else if (h->retries[port] < USBHOST_PORT_RETRIES) {
+    h->retries[port]++;
+    h->retry_port = port;
+    h->retry_at = tusb_time_millis_api() + 200u*h->retries[port];
+    tuh_hub_retry_cb(daddr, port, h->retries[port], "reset retry");
+  } else {
+    tuh_hub_retry_cb(daddr, port, h->retries[port], "exhausted");
+  }
+  hub_edpt_status_xfer(daddr);
+}
